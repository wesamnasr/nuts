generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["driverAdapters"]
    binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
}

model Category {
    id        String     @id @default(uuid())
    nameAr    String
    nameEn    String
    slug      String     @unique
    image     String?
    parentId  String?
    sortOrder Int        @default(0)
    isActive  Boolean    @default(true)
    createdAt DateTime   @default(now()) @db.Timestamp(6)
    updatedAt DateTime   @default(now()) @updatedAt @db.Timestamp(6)
    parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onUpdate: NoAction)
    children  Category[] @relation("CategoryTree")
    products  Product[]

    @@index([slug], map: "idx_category_slug")
}

model Product {
    id                     String                  @id @default(uuid())
    categoryId             String
    nameAr                 String
    nameEn                 String
    descAr                 String?
    descEn                 String?
    slug                   String                  @unique
    isVisible              Boolean                 @default(true)
    isFeatured             Boolean                 @default(false)
    isDeleted              Boolean                 @default(false)
    materialAr             String?
    materialEn             String?
    madeInAr               String?
    madeInEn               String?
    warrantyAr             String?
    warrantyEn             String?
    installmentInfoAr      String?
    installmentInfoEn      String?
    deliveryInstallationAr String?
    deliveryInstallationEn String?
    recommendedSize        String?
    createdAt              DateTime                @default(now()) @db.Timestamp(6)
    updatedAt              DateTime                @default(now()) @updatedAt @db.Timestamp(6)
    cartItems              CartItem[]
    category               Category                @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
    collectionItems        ProductCollectionItem[]
    images                 ProductImage[]
    variants               ProductVariant[]
    reviews                Review[]
    whatsAppOrders         WhatsAppOrder[]

    @@index([categoryId], map: "idx_product_category")
    @@index([slug], map: "idx_product_slug")
    @@index([isVisible, isFeatured], map: "idx_product_visible")
}

model ProductImage {
    id        String  @id @default(uuid())
    productId String
    url       String
    altText   String?
    sortOrder Int     @default(0)
    isMain    Boolean @default(false)
    publicId  String?
    product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

    @@index([productId], map: "idx_image_product")
}

model ProductVariant {
    id             String          @id @default(uuid())
    productId      String
    sizeNameAr     String?
    sizeNameEn     String?
    detailedSizeAr String?
    detailedSizeEn String?
    colorAr        String?
    colorEn        String?
    sku            String?
    price          Decimal         @db.Decimal(10, 2)
    discountPrice  Decimal?        @db.Decimal(10, 2)
    stock          Int             @default(0)
    isDefault      Boolean         @default(false)
    showPrice      Boolean         @default(true)
    sortOrder      Int             @default(0)
    createdAt      DateTime        @default(now()) @db.Timestamp(6)
    cartItems      CartItem[]
    product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
    whatsAppOrders WhatsAppOrder[]

    @@index([productId], map: "idx_variant_product")
}

model WhatsAppOrder {
    id            String          @id @default(uuid())
    customerName  String
    customerPhone String
    productId     String
    variantId     String?
    message       String?
    status        OrderStatus     @default(PENDING)
    createdAt     DateTime        @default(now()) @db.Timestamp(6)
    updatedAt     DateTime        @default(now()) @updatedAt @db.Timestamp(6)
    product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
    variant       ProductVariant? @relation(fields: [variantId], references: [id], onUpdate: NoAction)
}

model Cart {
    id        String     @id @default(uuid())
    sessionId String     @unique
    createdAt DateTime   @default(now()) @db.Timestamp(6)
    updatedAt DateTime   @default(now()) @updatedAt @db.Timestamp(6)
    items     CartItem[]
}

model CartItem {
    id        String          @id @default(uuid())
    cartId    String
    productId String
    variantId String?
    quantity  Int             @default(1)
    createdAt DateTime        @default(now()) @db.Timestamp(6)
    cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: NoAction)
    product   Product         @relation(fields: [productId], references: [id], onUpdate: NoAction)
    variant   ProductVariant? @relation(fields: [variantId], references: [id], onUpdate: NoAction)
}

model Policy {
    id        String     @id @default(uuid())
    type      PolicyType @unique
    contentAr String
    contentEn String
    createdAt DateTime   @default(now()) @db.Timestamp(6)
    updatedAt DateTime   @default(now()) @updatedAt @db.Timestamp(6)
}

model Setting {
    key       String   @id
    value     String
    createdAt DateTime @default(now()) @db.Timestamp(6)
    updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)
}

model LandingPageConfig {
    id                  String    @id @default(uuid())
    heroTitleAr         String
    heroTitleEn         String
    heroSubtitleAr      String
    heroSubtitleEn      String
    heroImage           String
    heroButtonTextAr    String
    heroButtonTextEn    String
    heroLink            String    @default("/shop")
    showHero            Boolean   @default(true)
    showFeatures        Boolean   @default(true)
    showNewArrivals     Boolean   @default(true)
    showBestSellers     Boolean   @default(true)
    showFlashSales      Boolean   @default(true)
    showCategories      Boolean   @default(true)
    showTestimonials    Boolean   @default(true)
    showNewsletter      Boolean   @default(true)
    showCustomerPhotos  Boolean   @default(true)
    sectionsOrder       Json?
    flashSaleEndDate    DateTime? @db.Timestamp(6)
    flashSaleDiscount   Int?      @default(0)
    manualFlashSaleId   String?
    manualNewArrivalIds String[]  @default([])
    manualBestSellerIds String[]  @default([])
    manualFlashSaleIds  String[]  @default([])
    updatedAt           DateTime  @default(now()) @updatedAt @db.Timestamp(6)
}

model CustomerPhoto {
    id        String   @id @default(uuid())
    image     String
    altText   String?
    sortOrder Int      @default(0)
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now()) @db.Timestamp(6)
    updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)
}

model StoreFeature {
    id        String   @id @default(uuid())
    titleAr   String
    titleEn   String
    descAr    String
    descEn    String
    icon      String
    sortOrder Int      @default(0)
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now()) @db.Timestamp(6)
    updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)
}

model ProductCollection {
    id        String                  @id @default(uuid())
    titleAr   String
    titleEn   String
    isActive  Boolean                 @default(true)
    createdAt DateTime                @default(now()) @db.Timestamp(6)
    updatedAt DateTime                @default(now()) @updatedAt @db.Timestamp(6)
    items     ProductCollectionItem[]
}

model ProductCollectionItem {
    id           String            @id @default(uuid())
    collectionId String
    productId    String
    sortOrder    Int               @default(0)
    collection   ProductCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
    product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Review {
    id             String   @id @default(uuid())
    productId      String?
    customerName   String
    customerImage  String?
    rating         Int      @default(5)
    comment        String?
    commentAr      String?
    commentEn      String?
    customerPhone  String?
    customerRoleAr String?
    customerRoleEn String?
    isApproved     Boolean  @default(false)
    isFeatured     Boolean  @default(false)
    createdAt      DateTime @default(now()) @db.Timestamp(6)
    updatedAt      DateTime @default(now()) @updatedAt @db.Timestamp(6)
    product        Product? @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

    @@index([isApproved, isFeatured], map: "idx_review_status")
}

model PortfolioCategory {
    id            String          @id @default(uuid())
    titleAr       String
    titleEn       String
    descriptionAr String? // New: Description in Arabic
    descriptionEn String? // New: Description in English
    logo          String? // New: Category Logo
    coverImage    String? // New: Category Cover Image
    accentColor   String?         @default("#d8a868") // Custom color for the section
    fontFamily    String? // Custom font family
    sortOrder     Int             @default(0)
    isActive      Boolean         @default(true)
    createdAt     DateTime        @default(now()) @db.Timestamp(6)
    updatedAt     DateTime        @default(now()) @updatedAt @db.Timestamp(6)
    items         PortfolioItem[]
}

model PortfolioItem {
    id              String            @id @default(uuid())
    categoryId      String
    titleAr         String?
    titleEn         String?
    descriptionAr   String?
    descriptionEn   String?
    mediaType       MediaType         @default(IMAGE)
    mediaUrl        String
    thumbnailUrl    String? // For videos
    whatsappMessage String? // Custom message for WhatsApp
    sortOrder       Int               @default(0)
    isActive        Boolean           @default(true)
    createdAt       DateTime          @default(now()) @db.Timestamp(6)
    updatedAt       DateTime          @default(now()) @updatedAt @db.Timestamp(6)
    category        PortfolioCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

    @@index([categoryId], map: "idx_portfolio_category")
}

enum MediaType {
    IMAGE
    VIDEO
}

enum OrderStatus {
    PENDING
    CONTACTED
    COMPLETED
    CANCELLED
}

enum PolicyType {
    SHIPPING
    RETURN
    INSTALLATION
}

model PortfolioConfig {
    id          String   @id @default(uuid())
    heroTitleAr String?
    heroTitleEn String?
    heroDescAr  String?
    heroDescEn  String?
    stats       Json?    @default("[]")
    showStats   Boolean  @default(true)
    updatedAt   DateTime @default(now()) @updatedAt @db.Timestamp(6)
}

model AboutSection {
    id            String   @id @default(uuid())
    titleAr       String
    titleEn       String
    descriptionAr String
    descriptionEn String
    image         String?
    sortOrder     Int      @default(0)
    isActive      Boolean  @default(true)
    createdAt     DateTime @default(now()) @db.Timestamp(6)
    updatedAt     DateTime @default(now()) @updatedAt @db.Timestamp(6)
}

model AdminUser {
    id           String   @id @default(uuid())
    username     String   @unique
    passwordHash String
    createdAt    DateTime @default(now()) @db.Timestamp(6)
    updatedAt    DateTime @default(now()) @updatedAt @db.Timestamp(6)
}
